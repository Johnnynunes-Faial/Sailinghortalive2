{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sailinghortalive2",
  "compatibility_date": "2026-09-27",

  "main": "./src/worker.ts",

  "keep_vars": true,

  "vars": {
    "TRACCAR_URL": "https://api.sailinghortalive.com"
  },

  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*"
    ]
  }
}

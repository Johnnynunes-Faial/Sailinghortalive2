{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sailinghortalive2",
  "compatibility_date": "2026-09-27",
  "main": "./src/worker.ts",
  "keep_vars": true,
  "vars": {
    "TRACCAR_URL": "https://api.sailinghortalive.com",
    "UNKNOWN_MONITOR_URL": "https://monitor.sailinghortalive.com/unknown-devices"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_id": "7e586c8d-1b50-4d4a-b79a-5a7bb2976ea7"
    }
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*",
      "/admin/api/*"
    ]
  }
}
